{
  // medvault.com: the marketing page, static files only (no Worker code, free). The app is the
  // separate "med-vault" Worker at app.medvault.com. See docs/LANDING.md.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "med-vault-landing",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "workers_dev": true
  // Once medvault.com is in this Cloudflare account, add:
  // "routes": [{ "pattern": "medvault.com", "custom_domain": true }, { "pattern": "www.medvault.com", "custom_domain": true }]
}
