{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "med-vault",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // SPA: unknown paths serve index.html; /api/* always hits the Worker
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "med-vault",
      // Replace with the id printed by `npx wrangler d1 create med-vault`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "med-vault-files"
    }
  ],
  "ai": { "binding": "AI" },
  // Shown in the privacy notice (docs/COMPLIANCE.md): who runs this deployment and where to send
  // privacy requests and complaints. Public values, not secrets.
  "vars": { "OPERATOR_NAME": "", "GRIEVANCE_EMAIL": "" },
  "observability": { "enabled": true }
}
